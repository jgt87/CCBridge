# Generated by probe.ps1 on each machine
probe-report.txt

# Node dependencies for building the UI (ui/ is the committed build output)
ui-src/node_modules/

# Local copy of a probe report (machine details)
probe - Copy.txt

# Output of capture.cmd (review before sharing)
capture-report.json

# Machine-specific settings (kept across updates)
config/*.local.json
# Written by the installer/updater
version.txt

# Release builds (tools\build-release.ps1)
dist/

# Local code-index cache (repowise)
.repowise/
