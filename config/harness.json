{
  "port": 8765,
  "cdpPort": 9333,
  "projectsFolder": "CCBridge",
  "maxRounds": 12,
  "promptCharBudget": 75000,
  "resultCharBudget": 60000,
  "replyTimeoutSec": 300,
  "agentTimeoutSec": 1800,
  "commandTimeoutSec": 180,
  "rolloverMargin": 2,
  "messagesPerChat": 30,
  "autoApproveCommands": [],
  "workIq": "leave",
  "startMode": "ask",
  "chatHistory": true,
  "saveReplyFrames": true,
  "autoUpdate": true,
  "webRead": "named-sites",
  "signIn": "single-sign-on",
  "fileChangeCounts": "last-change",
  "stallSec": 90,
  "actionRetries": 2,
  "reviewAfterChanges": "big",
  "reviewMinLines": 40,
  "appWindow": "copilot-tab",
  "responseMode": "leave",
  "chainScripts": "approve-once",
  "evidence": "on",
  "pageCheck": "on",
  "issues": {
    "enabled": "on",
    "autoFix": "error",
    "maxAttempts": 2
  },
  "retention": {
    "historyCount": 20,
    "historyDays": 90,
    "evidenceCount": 100,
    "evidenceDays": 90,
    "reviewsCount": 20,
    "reviewsDays": 180,
    "backupsCount": 100,
    "backupsDays": 30,
    "chatEvents": 1500,
    "note": "How much of what StreamHub generates per project is kept (Settings > Retention); 0 = no limit."
  },
  "pacing": {
    "newChatSettleSec": 3,
    "beforeSendSec": 1,
    "betweenPromptsSec": 5,
    "note": "Pauses that give Copilot's page time to finish its own work: after a new chat is ready, between typing the prompt and pressing Send, and the minimum gap after the previous reply. Completing tasks matters more than speed."
  }
}