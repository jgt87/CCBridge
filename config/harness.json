{
  "port": 8765,
  "cdpPort": 9333,
  "projectsFolder": "CCBridge",
  "maxRounds": 12,
  "promptCharBudget": 75000,
  "resultCharBudget": 60000,
  "replyTimeoutSec": 300,
  "agentTimeoutSec": 1800,
  "commandTimeoutSec": 180,
  "rolloverMargin": 2,
  "messagesPerChat": 30,
  "autoApproveCommands": [],
  "protectedPaths": [],
  "hooks": true,
  "workIq": "leave",
  "startMode": "ask",
  "chatHistory": true,
  "dataCopies": true,
  "saveReplyFrames": true,
  "autoUpdate": true,
  "webRead": "named-sites",
  "signIn": "single-sign-on",
  "fileChangeCounts": "last-change",
  "stallSec": 90,
  "actionRetries": 2,
  "reviewAfterChanges": "big",
  "reviewMinLines": 40,
  "appWindow": "copilot-tab",
  "responseMode": "leave",
  "newChatOnSwitch": true,
  "repoMapChars": 4000,
  "chainScripts": "approve-once",
  "evidence": "on",
  "autoTests": true,
  "pageScreenshot": true,
  "pageCheck": "on",
  "enforcement": "standard",
  "checks": {
    "generated": true,
    "tools": true,
    "powershell7": true,
    "quality": true,
    "contrast": true
  },
  "issues": {
    "enabled": "on",
    "autoFix": "error",
    "maxAttempts": 2
  },
  "retention": {
    "historyCount": 20,
    "historyDays": 90,
    "evidenceCount": 100,
    "evidenceDays": 90,
    "reviewsCount": 20,
    "reviewsDays": 180,
    "chartsCount": 20,
    "chartsDays": 90,
    "backupsCount": 100,
    "backupsDays": 30,
    "chatEvents": 1500,
    "note": "How much of what StreamHub generates per project is kept (Settings > Retention); 0 = no limit."
  },
  "copilotTheme": true,
  "uiKit": true,
  "uiKitColors": "blue",
  "uiKitParts": {
    "interactive": true,
    "charts": true,
    "icons": true,
    "react": true,
    "designRules": true,
    "slopChecks": true
  },
  "pacing": {
    "newChatSettleSec": 3,
    "beforeSendSec": 1,
    "betweenPromptsSec": 5,
    "lateReplySec": 2,
    "chainStepSec": 10,
    "chainRetrySec": [120, 300],
    "note": "In a chain: chainStepSec pauses between Copilot steps, and a step Copilot gave no answer to is tried again in a new chat after each wait in chainRetrySec. Pauses that give Copilot's page time to finish its own work: after a new chat is ready, between typing the prompt and pressing Send, the minimum gap after the previous reply, and the wait after a reply ended before it is read once more from the page (a part that arrives late is added; 0 = off). Completing tasks matters more than speed."
  }
}