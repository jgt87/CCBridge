{
  "port": 8765,
  "cdpPort": 9333,
  "projectsFolder": "CCBridge",
  "maxRounds": 12,
  "promptCharBudget": 75000,
  "resultCharBudget": 60000,
  "replyTimeoutSec": 300,
  "commandTimeoutSec": 180,
  "rolloverMargin": 2,
  "messagesPerChat": 30,
  "autoApproveCommands": [],
  "workIq": "leave",
  "startMode": "ask",
  "chatHistory": true,
  "saveReplyFrames": true,
  "autoUpdate": true,
  "stallSec": 90,
  "actionRetries": 2,
  "reviewAfterChanges": "big",
  "reviewMinLines": 40,
  "appWindow": "copilot-tab",
  "responseMode": "leave",
  "evidence": "on",
  "pageCheck": "on",
  "issues": {
    "enabled": "on",
    "autoFix": "error",
    "maxAttempts": 2
  },
  "pacing": {
    "newChatSettleSec": 3,
    "beforeSendSec": 1,
    "betweenPromptsSec": 5,
    "note": "Pauses that give Copilot's page time to finish its own work: after a new chat is ready, between typing the prompt and pressing Send, and the minimum gap after the previous reply. Completing tasks matters more than speed."
  }
