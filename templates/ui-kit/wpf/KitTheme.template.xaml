<!--
  UI kit for PowerShell window apps (WPF), written by the helper program from styles/kit/tokens.css:
  do not edit (change the colours in tokens.css). Load it into the application before the window:
    $theme = [Windows.Markup.XamlReader]::Parse([IO.File]::ReadAllText((Join-Path $root 'styles\kit\wpf\KitTheme.xaml')))
    $app = [Windows.Application]::Current; if (-not $app) { $app = New-Object Windows.Application }
    $app.Resources.MergedDictionaries.Add($theme)
    $window = [Windows.Markup.XamlReader]::Parse($xaml)
  Buttons, fields, tables, check boxes and progress bars then take the kit's look by themselves; a main
  action uses Style="{StaticResource KitPrimaryButton}", a muted text Style="{StaticResource KitMuted}",
  a heading Style="{StaticResource KitTitle}", a panel <Border Style="{StaticResource KitPanel}">.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="KitBg" Color="{{bg}}"/>
  <SolidColorBrush x:Key="KitSurface" Color="{{surface}}"/>
  <SolidColorBrush x:Key="KitSurface2" Color="{{surface-2}}"/>
  <SolidColorBrush x:Key="KitText" Color="{{text}}"/>
  <SolidColorBrush x:Key="KitTextMuted" Color="{{text-muted}}"/>
  <SolidColorBrush x:Key="KitBorder" Color="{{border}}"/>
  <SolidColorBrush x:Key="KitBorderStrong" Color="{{border-strong}}"/>
  <SolidColorBrush x:Key="KitAccent" Color="{{accent}}"/>
  <SolidColorBrush x:Key="KitAccentHover" Color="{{accent-hover}}"/>
  <SolidColorBrush x:Key="KitAccentSoft" Color="{{accent-soft}}"/>
  <SolidColorBrush x:Key="KitOnAccent" Color="{{on-accent}}"/>
  <SolidColorBrush x:Key="KitOk" Color="{{ok}}"/>
  <SolidColorBrush x:Key="KitWarn" Color="{{warn}}"/>
  <SolidColorBrush x:Key="KitError" Color="{{error}}"/>
  <SolidColorBrush x:Key="KitChart1" Color="{{chart-1}}"/>
  <SolidColorBrush x:Key="KitChart2" Color="{{chart-2}}"/>
  <SolidColorBrush x:Key="KitChart3" Color="{{chart-3}}"/>
  <SolidColorBrush x:Key="KitChart4" Color="{{chart-4}}"/>
  <SolidColorBrush x:Key="KitChart5" Color="{{chart-5}}"/>
  <SolidColorBrush x:Key="KitChart6" Color="{{chart-6}}"/>
  <FontFamily x:Key="KitFont">{{font}}</FontFamily>

  <Style TargetType="Window">
    <Setter Property="Background" Value="{StaticResource KitBg}"/>
    <Setter Property="Foreground" Value="{StaticResource KitText}"/>
    <Setter Property="FontFamily" Value="{StaticResource KitFont}"/>
    <Setter Property="FontSize" Value="14"/>
  </Style>
  <!-- No style for every TextBlock: it would also colour the text inside buttons (the window's colour
       reaches all text by itself). -->
  <Style x:Key="KitTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
    <Setter Property="Foreground" Value="{StaticResource KitText}"/>
  </Style>
  <Style x:Key="KitMuted" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource KitTextMuted}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style x:Key="KitPanel" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource KitSurface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource KitBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{{radius-lg}}"/>
    <Setter Property="Padding" Value="16"/>
  </Style>

  <Style TargetType="Button">
    <Setter Property="Background" Value="{StaticResource KitSurface}"/>
    <Setter Property="Foreground" Value="{StaticResource KitText}"/>
    <Setter Property="BorderBrush" Value="{StaticResource KitBorderStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,6"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{{radius}}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource KitSurface2}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource KitAccent}"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="KitPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource KitAccent}"/>
    <Setter Property="Foreground" Value="{StaticResource KitOnAccent}"/>
    <Setter Property="BorderBrush" Value="{StaticResource KitAccent}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{{radius}}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource KitAccentHover}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource KitText}"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource KitSurface}"/>
    <Setter Property="Foreground" Value="{StaticResource KitText}"/>
    <Setter Property="BorderBrush" Value="{StaticResource KitBorderStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="PasswordBox">
    <Setter Property="Background" Value="{StaticResource KitSurface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource KitBorderStrong}"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="MinHeight" Value="32"/>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource KitText}"/>
    <Setter Property="Margin" Value="0,4"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="Label">
    <Setter Property="Foreground" Value="{StaticResource KitText}"/>
    <Setter Property="Padding" Value="0,0,0,4"/>
  </Style>

  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="{StaticResource KitSurface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource KitBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource KitBorder}"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="RowBackground" Value="{StaticResource KitSurface}"/>
    <Setter Property="AlternatingRowBackground" Value="{StaticResource KitBg}"/>
    <Setter Property="CanUserSortColumns" Value="True"/>
    <Setter Property="AutoGenerateColumns" Value="True"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="RowHeight" Value="30"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{StaticResource KitSurface2}"/>
    <Setter Property="Foreground" Value="{StaticResource KitText}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="BorderBrush" Value="{StaticResource KitBorder}"/>
    <Setter Property="BorderThickness" Value="0,0,1,1"/>
  </Style>

  <Style TargetType="ProgressBar">
    <Setter Property="Foreground" Value="{StaticResource KitAccent}"/>
    <Setter Property="Background" Value="{StaticResource KitSurface2}"/>
    <Setter Property="Height" Value="8"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border x:Name="PART_Track" CornerRadius="4" Background="{TemplateBinding Background}"/>
            <Border x:Name="PART_Indicator" CornerRadius="4" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
