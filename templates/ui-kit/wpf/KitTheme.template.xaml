<!--
  UI kit for PowerShell window apps (WPF), written by the helper program from styles/kit/tokens.css:
  do not edit (change the colours in tokens.css). Load it into the application before the window:
    $theme = [Windows.Markup.XamlReader]::Parse([IO.File]::ReadAllText((Join-Path $root 'styles\kit\wpf\KitTheme.xaml')))
    $app = [Windows.Application]::Current; if (-not $app) { $app = New-Object Windows.Application }
    $app.Resources.MergedDictionaries.Add($theme)
    $window = [Windows.Markup.XamlReader]::Parse($xaml)
  Buttons, fields, tables, check boxes and progress bars then take the kit's look by themselves; a main
  action uses Style="{StaticResource KitPrimaryButton}", a muted text Style="{StaticResource KitMuted}",
  a heading Style="{StaticResource KitTitle}", a panel <Border Style="{StaticResource KitPanel}">.
  A status word is <Border Style="{StaticResource KitBadgeOk}"><TextBlock Text="Done"/></Border> (KitBadge,
  KitBadgeAccent, KitBadgeOk, KitBadgeWarn, KitBadgeError), a message in the window
  <Border Style="{StaticResource KitNoticeError}"><TextBlock TextWrapping="Wrap" Text="..."/></Border> (KitNotice,
  KitNoticeOk, KitNoticeWarn, KitNoticeError), an on/off setting <ToggleButton Style="{StaticResource KitSwitch}"
  Content="Send a copy"/>: the web kit's kit-badge, kit-notice and kit-switch.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="KitBg" Color="{{bg}}"/>
  <SolidColorBrush x:Key="KitSurface" Color="{{surface}}"/>
  <SolidColorBrush x:Key="KitSurface2" Color="{{surface-2}}"/>
  <SolidColorBrush x:Key="KitText" Color="{{text}}"/>
  <SolidColorBrush x:Key="KitTextMuted" Color="{{text-muted}}"/>
  <SolidColorBrush x:Key="KitBorder" Color="{{border}}"/>
  <SolidColorBrush x:Key="KitBorderStrong" Color="{{border-strong}}"/>
  <SolidColorBrush x:Key="KitAccent" Color="{{accent}}"/>
  <SolidColorBrush x:Key="KitAccentHover" Color="{{accent-hover}}"/>
  <SolidColorBrush x:Key="KitAccentSoft" Color="{{accent-soft}}"/>
  <SolidColorBrush x:Key="KitOnAccent" Color="{{on-accent}}"/>
  <SolidColorBrush x:Key="KitOk" Color="{{ok}}"/>
  <SolidColorBrush x:Key="KitWarn" Color="{{warn}}"/>
  <SolidColorBrush x:Key="KitError" Color="{{error}}"/>
  <SolidColorBrush x:Key="KitOkSoft" Color="{{ok-soft}}"/>
  <SolidColorBrush x:Key="KitWarnSoft" Color="{{warn-soft}}"/>
  <SolidColorBrush x:Key="KitErrorSoft" Color="{{error-soft}}"/>
  <SolidColorBrush x:Key="KitChart1" Color="{{chart-1}}"/>
  <SolidColorBrush x:Key="KitChart2" Color="{{chart-2}}"/>
  <SolidColorBrush x:Key="KitChart3" Color="{{chart-3}}"/>
  <SolidColorBrush x:Key="KitChart4" Color="{{chart-4}}"/>
  <SolidColorBrush x:Key="KitChart5" Color="{{chart-5}}"/>
  <SolidColorBrush x:Key="KitChart6" Color="{{chart-6}}"/>
  <FontFamily x:Key="KitFont">{{font}}</FontFamily>

  <Style TargetType="Window">
    <Setter Property="Background" Value="{StaticResource KitBg}"/>
    <Setter Property="Foreground" Value="{StaticResource KitText}"/>
    <Setter Property="FontFamily" Value="{StaticResource KitFont}"/>
    <Setter Property="FontSize" Value="14"/>
  </Style>
  <!-- No style for every TextBlock: it would also colour the text inside buttons (the window's colour
       reaches all text by itself). -->
  <Style x:Key="KitTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
    <Setter Property="Foreground" Value="{StaticResource KitText}"/>
  </Style>
  <Style x:Key="KitMuted" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource KitTextMuted}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style x:Key="KitPanel" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource KitSurface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource KitBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{{radius-lg}}"/>
    <Setter Property="Padding" Value="16"/>
  </Style>

  <Style TargetType="Button">
    <Setter Property="Background" Value="{StaticResource KitSurface}"/>
    <Setter Property="Foreground" Value="{StaticResource KitText}"/>
    <Setter Property="BorderBrush" Value="{StaticResource KitBorderStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,6"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{{radius}}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource KitSurface2}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource KitAccent}"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="KitPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource KitAccent}"/>
    <Setter Property="Foreground" Value="{StaticResource KitOnAccent}"/>
    <Setter Property="BorderBrush" Value="{StaticResource KitAccent}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{{radius}}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource KitAccentHover}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource KitText}"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource KitSurface}"/>
    <Setter Property="Foreground" Value="{StaticResource KitText}"/>
    <Setter Property="BorderBrush" Value="{StaticResource KitBorderStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="PasswordBox">
    <Setter Property="Background" Value="{StaticResource KitSurface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource KitBorderStrong}"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource KitText}"/>
    <Setter Property="Margin" Value="0,4"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="Label">
    <Setter Property="Foreground" Value="{StaticResource KitText}"/>
    <Setter Property="Padding" Value="0,0,0,4"/>
  </Style>

  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="{StaticResource KitSurface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource KitBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource KitBorder}"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="RowBackground" Value="{StaticResource KitSurface}"/>
    <Setter Property="AlternatingRowBackground" Value="{StaticResource KitBg}"/>
    <Setter Property="CanUserSortColumns" Value="True"/>
    <Setter Property="AutoGenerateColumns" Value="True"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="RowHeight" Value="30"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{StaticResource KitSurface2}"/>
    <Setter Property="Foreground" Value="{StaticResource KitText}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="BorderBrush" Value="{StaticResource KitBorder}"/>
    <Setter Property="BorderThickness" Value="0,0,1,1"/>
  </Style>

  <Style TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource KitText}"/>
    <Setter Property="Margin" Value="0,4"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="Background" Value="{StaticResource KitSurface}"/>
    <Setter Property="Foreground" Value="{StaticResource KitText}"/>
  </Style>
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{StaticResource KitSurface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource KitBorder}"/>
    <Setter Property="Foreground" Value="{StaticResource KitText}"/>
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="8,6"/>
  </Style>
  <Style TargetType="ListView">
    <Setter Property="Background" Value="{StaticResource KitSurface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource KitBorder}"/>
    <Setter Property="Foreground" Value="{StaticResource KitText}"/>
  </Style>
  <Style TargetType="ListViewItem">
    <Setter Property="Padding" Value="8,6"/>
  </Style>
  <Style TargetType="TabControl">
    <Setter Property="Background" Value="{StaticResource KitSurface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource KitBorder}"/>
    <Setter Property="Padding" Value="12"/>
  </Style>
  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{StaticResource KitText}"/>
    <Setter Property="Padding" Value="14,6"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Tab" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource KitAccent}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="{StaticResource KitSurface2}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Menu">
    <Setter Property="Background" Value="{StaticResource KitSurface}"/>
    <Setter Property="Foreground" Value="{StaticResource KitText}"/>
    <Setter Property="FontFamily" Value="{StaticResource KitFont}"/>
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="Padding" Value="8,4"/>
  </Style>
  <Style TargetType="ContextMenu">
    <Setter Property="Background" Value="{StaticResource KitSurface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource KitBorder}"/>
    <Setter Property="FontFamily" Value="{StaticResource KitFont}"/>
  </Style>
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource KitSurface}"/>
    <Setter Property="Foreground" Value="{StaticResource KitText}"/>
    <Setter Property="BorderBrush" Value="{StaticResource KitBorder}"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="FontFamily" Value="{StaticResource KitFont}"/>
  </Style>
  <Style TargetType="GroupBox">
    <Setter Property="BorderBrush" Value="{StaticResource KitBorder}"/>
    <Setter Property="Foreground" Value="{StaticResource KitText}"/>
    <Setter Property="Padding" Value="12"/>
  </Style>
  <Style TargetType="DatePicker">
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="BorderBrush" Value="{StaticResource KitBorderStrong}"/>
    <Setter Property="Padding" Value="4,2"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="Expander">
    <Setter Property="Foreground" Value="{StaticResource KitText}"/>
    <Setter Property="BorderBrush" Value="{StaticResource KitBorder}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="0,6"/>
  </Style>
  <Style TargetType="TreeView">
    <Setter Property="Background" Value="{StaticResource KitSurface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource KitBorder}"/>
    <Setter Property="Foreground" Value="{StaticResource KitText}"/>
  </Style>
  <Style TargetType="TreeViewItem">
    <Setter Property="Padding" Value="4,3"/>
  </Style>
  <Style TargetType="ToolBar">
    <Setter Property="Background" Value="{StaticResource KitSurface}"/>
  </Style>
  <Style TargetType="StatusBar">
    <Setter Property="Background" Value="{StaticResource KitSurface2}"/>
    <Setter Property="Foreground" Value="{StaticResource KitTextMuted}"/>
  </Style>
  <Style TargetType="Slider">
    <Setter Property="Foreground" Value="{StaticResource KitAccent}"/>
  </Style>

  <!-- Badge (kit-badge): a pill with a short status word, 12px semibold. -->
  <Style x:Key="KitBadge" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource KitSurface2}"/>
    <Setter Property="TextElement.Foreground" Value="{StaticResource KitTextMuted}"/>
    <Setter Property="TextElement.FontSize" Value="12"/>
    <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
    <Setter Property="CornerRadius" Value="11"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="MinHeight" Value="22"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="KitBadgeAccent" TargetType="Border" BasedOn="{StaticResource KitBadge}">
    <Setter Property="Background" Value="{StaticResource KitAccentSoft}"/>
    <Setter Property="TextElement.Foreground" Value="{StaticResource KitAccent}"/>
  </Style>
  <Style x:Key="KitBadgeOk" TargetType="Border" BasedOn="{StaticResource KitBadge}">
    <Setter Property="Background" Value="{StaticResource KitOkSoft}"/>
    <Setter Property="TextElement.Foreground" Value="{StaticResource KitOk}"/>
  </Style>
  <Style x:Key="KitBadgeWarn" TargetType="Border" BasedOn="{StaticResource KitBadge}">
    <Setter Property="Background" Value="{StaticResource KitWarnSoft}"/>
    <Setter Property="TextElement.Foreground" Value="{StaticResource KitWarn}"/>
  </Style>
  <Style x:Key="KitBadgeError" TargetType="Border" BasedOn="{StaticResource KitBadge}">
    <Setter Property="Background" Value="{StaticResource KitErrorSoft}"/>
    <Setter Property="TextElement.Foreground" Value="{StaticResource KitError}"/>
  </Style>
  <!-- Notice (kit-notice): a tinted block with a full border, 14px text; no side stripe. -->
  <Style x:Key="KitNotice" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource KitSurface2}"/>
    <Setter Property="BorderBrush" Value="{StaticResource KitBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{{radius}}"/>
    <Setter Property="Padding" Value="16,12"/>
    <Setter Property="TextElement.Foreground" Value="{StaticResource KitText}"/>
    <Setter Property="TextElement.FontSize" Value="14"/>
  </Style>
  <Style x:Key="KitNoticeOk" TargetType="Border" BasedOn="{StaticResource KitNotice}">
    <Setter Property="Background" Value="{StaticResource KitOkSoft}"/>
    <Setter Property="BorderBrush" Value="{StaticResource KitOk}"/>
  </Style>
  <Style x:Key="KitNoticeWarn" TargetType="Border" BasedOn="{StaticResource KitNotice}">
    <Setter Property="Background" Value="{StaticResource KitWarnSoft}"/>
    <Setter Property="BorderBrush" Value="{StaticResource KitWarn}"/>
  </Style>
  <Style x:Key="KitNoticeError" TargetType="Border" BasedOn="{StaticResource KitNotice}">
    <Setter Property="Background" Value="{StaticResource KitErrorSoft}"/>
    <Setter Property="BorderBrush" Value="{StaticResource KitError}"/>
  </Style>
  <!-- Switch (kit-switch): a 36 x 20 pill track (the strong border colour, the accent when on) with a 16px knob, then the label. -->
  <Style x:Key="KitSwitch" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{StaticResource KitText}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Ring" BorderThickness="2" BorderBrush="Transparent" CornerRadius="12" VerticalAlignment="Center">
              <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" Background="{StaticResource KitBorderStrong}">
                <Ellipse x:Name="Knob" Width="16" Height="16" Margin="2" Fill="{StaticResource KitSurface}" HorizontalAlignment="Left"/>
              </Border>
            </Border>
            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{StaticResource KitAccent}"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource KitAccent}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ProgressBar">
    <Setter Property="Foreground" Value="{StaticResource KitAccent}"/>
    <Setter Property="Background" Value="{StaticResource KitSurface2}"/>
    <Setter Property="Height" Value="8"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border x:Name="PART_Track" CornerRadius="4" Background="{TemplateBinding Background}"/>
            <Border x:Name="PART_Indicator" CornerRadius="4" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
